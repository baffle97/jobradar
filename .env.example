# JobRadar Environment Variables

# Adzuna API (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Gemini API (https://ai.google.dev/), used by the eligibility agent; leave unset
# for rules only. ELIGIBILITY_MODEL overrides the default gemini-3.5-flash-lite.
GOOGLE_GENERATIVE_AI_API_KEY=
ELIGIBILITY_MODEL=

# Telegram Bot (https://core.telegram.org/bots#botfather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Turso (libSQL); leave unset to use the local file apps/web/data/jobradar.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# App
SESSION_SECRET=change-me-to-a-random-string
# Bearer token Vercel Cron sends to /api/cron/:task (also accepted by /api/scrape)
CRON_SECRET=
